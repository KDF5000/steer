# syntax=docker/dockerfile:1

# Used by the source development Compose overrides. relay-source is a named
# build context, so the normal release build never depends on a sibling checkout.
FROM golang:1.26-alpine AS build
WORKDIR /src
ENV GOWORK=off
COPY --from=relay-source / /relay
COPY server/go.mod server/go.sum ./
RUN go env -w GOPROXY="https://goproxy.cn|https://proxy.golang.org|direct" \
    && go mod edit -replace=github.com/KDF5000/relay=/relay \
    && go mod download
COPY server/ ./
# COPY includes the release go.mod; apply the local replacement again.
RUN go mod edit -replace=github.com/KDF5000/relay=/relay \
    && CGO_ENABLED=0 go build -trimpath -o /out/steer-server ./cmd/steer-server

FROM alpine:3.22
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY --from=build /out/steer-server /usr/local/bin/steer-server
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["steer-server"]

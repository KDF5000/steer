DATABASE_URL=postgres://steer:steer@127.0.0.1:54329/steer
POSTGRES_PASSWORD=steer
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=54329
# Compose uses its bundled Relay Server by default. Set an external URL in production.
RELAY_BASE_URL=http://relay-server:8787
# Address that remote Relay Nodes can reach. This is displayed in onboarding.
RELAY_PUBLIC_URL=http://localhost:8787
# Use 0.0.0.0 only when Nodes on other machines must reach this host.
RELAY_BIND_ADDRESS=127.0.0.1
# Replace both development tokens before exposing Relay outside localhost.
RELAY_HOST_TOKEN=local-only-change-me-host-token
RELAY_NODE_TOKEN=local-only-change-me-node-token
RELAY_VERSION=v0.4.3
# Browser-reachable Steer API URL. Replace localhost with the remote host or domain.
NEXT_PUBLIC_STEER_API_URL=http://localhost:8080/api/v1
# Origin serving Steer Web. It must match the browser URL exactly.
STEER_ALLOWED_ORIGINS=http://localhost:3000
STEER_SERVER_BIND_ADDRESS=0.0.0.0
STEER_SERVER_PORT=8080
STEER_WEB_BIND_ADDRESS=0.0.0.0
STEER_WEB_PORT=3000
